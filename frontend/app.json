{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.usbdirectflow.oa70xx",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Stream your photos and videos to USB",
        "NSCameraUsageDescription": "Record video to stream to USB",
        "NSMicrophoneUsageDescription": "Record audio to stream to USB"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.usbdirectflow.oa70xx",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Air to Drive",
      "shortName": "AirToDrive",
      "lang": "en",
      "themeColor": "#00E5FF",
      "backgroundColor": "#0E0E0F",
      "display": "standalone",
      "startUrl": "/",
      "orientation": "any",
      "description": "Download massive files directly to external USB drives — zero phone storage required."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-video",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Stream your photos and videos to USB",
          "cameraPermission": "Record video to stream to USB",
          "microphonePermission": "Record audio to stream to USB"
        }
      ],
      "expo-document-picker",
      "@react-native-vector-icons/material-design-icons"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
