<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Screen capture runs in a foreground service (required for MediaProjection). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Needed for both app-audio (playback) capture and the microphone fallback. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ package visibility, so we can launch the Facebook app. -->
    <queries>
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.lite" />
    </queries>

    <application>
        <service
            android:name="expo.modules.usbscreencapture.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />
    </application>
</manifest>
